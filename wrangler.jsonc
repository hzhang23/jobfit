// The real Worker config, used by wrangler dev and wrangler deploy.
// Tests run against wrangler.test.jsonc, which is this file minus the AI
// binding. Any change here that adds or edits a binding belongs there too.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobfit",
  "main": "src/index.ts",
  // Pinned to what the test runtime actually honours. vitest-pool-workers 0.5.x
  // bundles miniflare 3.20241230.0, which caps here and silently falls back,
  // so a later date would mean tests and production run different runtimes.
  // Nothing in this project needs 2025 semantics. Verified by probe: both
  // WorkflowEntrypoint and NonRetryableError resolve at this date. Raise it
  // together with the test toolchain, not ahead of it.
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    { "name": "job-run", "binding": "JOB_RUN", "class_name": "JobRunWorkflow" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobfit",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    // Both roles use the same model. The two-model split existed to spend less
    // on the call that runs ten times per run than on the call that runs four.
    // Workers AI has no per-token price to arbitrage, and scoring is the
    // judgment-heavy half, so it gets the stronger model rather than the
    // cheaper one. The two vars stay separate so the roles can diverge later.
    "SCORING_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "TAILORING_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": { "enabled": true }
}
